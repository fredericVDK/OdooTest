<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.view.form.pigeon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="is_pigeon" invisible="1"/>
            </field>

            <xpath expr="//notebook" position="inside">
                <page string="Pigeon API" invisible="not is_pigeon">
                    <group>
                        <group string="Identification">
                            <field name="pigeon_api_id" readonly="1"/>
                            <field name="pigeon_wikidata_id" readonly="1"/>
                            <field name="pigeon_origin" readonly="1"/>
                        </group>
                        <group string="Sources">
                            <field
                                name="pigeon_source_url"
                                widget="url"
                                readonly="1"
                            />
                            <field
                                name="pigeon_image_url"
                                widget="url"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <group string="Wikipedia description">
                        <field
                            name="description_sale"
                            nolabel="1"
                            readonly="1"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_list" model="ir.ui.view">
        <field name="name">product.template.view.list.pigeon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="pigeon_origin" optional="hide"/>
                <field name="pigeon_wikidata_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="product_template_view_search" model="ir.ui.view">
        <field name="name">product.template.view.search.pigeon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter
                    name="pigeon"
                    string="Pigeons"
                    domain="[('is_pigeon', '=', True)]"
                />
            </xpath>
        </field>
    </record>
</odoo>